{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@/entities/*": ["./src/domain/entities/*"],
      "@/ports/*": ["./src/domain/ports/*"],
      "@/infrastructure/*": ["./src/infrastructure/*"],
      "@/*": ["./src/*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", ".expo/types/**/*.ts", "expo-env.d.ts"]
}
